<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Tarwe -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <TextView
            android:id="@+id/label_tarwe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="@color/widget_text_primary"
            android:text="@string/label_tarwe" />
        <TextView
            android:id="@+id/price_tarwe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary" />
        <ImageView
            android:id="@+id/trend_tarwe"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Gerst -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <TextView
            android:id="@+id/label_gerst"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="@color/widget_text_primary"
            android:text="@string/label_gerst" />
        <TextView
            android:id="@+id/price_gerst"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary" />
        <ImageView
            android:id="@+id/trend_gerst"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Mais -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <TextView
            android:id="@+id/label_mais"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="@color/widget_text_primary"
            android:text="@string/label_mais" />
        <TextView
            android:id="@+id/price_mais"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary" />
        <ImageView
            android:id="@+id/trend_mais"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!--
        A plain View is not on RemoteViews' inflatable-view allowlist and
        throws at runtime on a real widget host (only LinearLayout,
        FrameLayout, RelativeLayout, GridLayout and specific widget classes
        are supported), so a zero-content LinearLayout with a background
        color is used as the RemoteViews-safe divider instead.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@color/widget_text_secondary" />

    <!-- Koeien DU -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <TextView
            android:id="@+id/label_koeien_du"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="@color/widget_text_primary"
            android:text="@string/label_koeien_du" />
        <TextView
            android:id="@+id/price_koeien_du"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary" />
        <ImageView
            android:id="@+id/trend_koeien_du"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Koeien DE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <TextView
            android:id="@+id/label_koeien_de"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="@color/widget_text_primary"
            android:text="@string/label_koeien_de" />
        <TextView
            android:id="@+id/price_koeien_de"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary" />
        <ImageView
            android:id="@+id/trend_koeien_de"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/last_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="10sp"
        android:textColor="@color/widget_text_secondary"
        android:gravity="end" />

</LinearLayout>
